  "predicates": [
    {
      "id": "https://q2d.dev/predicates/dietary/menu-compatible",
      "version": "0.1",
      "status": "active",
      "title": "Menu compatibility",
      "question": "Is at least one item on this menu compatible with every dietary constraint the subject holds?",
      "question_notes": [
        "The formulation is deliberate. 'Is any item compatible' returns one bit about the menu as a whole. The alternative phrasing, 'which items conflict', returns a per-item vector and leaks the shape of the constraint set. Registries should prefer the least-disclosing formulation that still answers the task.",
        "A false answer does not reveal which constraint caused it, or how many exist."
      ],
      "release_shape": "boolean",
      "public_context_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "menu"
        ],
        "properties": {
          "menu": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "contains"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "contains": {
                  "type": "array",
                  "maxItems": 24,
                  "items": {
                    "type": "string",
                    "enum": [
                      "alcohol",
                      "celery",
                      "crustacean",
                      "egg",
                      "fish",
                      "gluten",
                      "lupin",
                      "meat",
                      "milk",
                      "mollusc",
                      "mustard",
                      "nut",
                      "peanut",
                      "pork",
                      "sesame",
                      "shellfish",
                      "soy",
                      "sulphite"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "private_input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "excludes"
        ],
        "properties": {
          "excludes": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "enum": [
                "alcohol",
                "celery",
                "crustacean",
                "egg",
                "fish",
                "gluten",
                "lupin",
                "meat",
                "milk",
                "mollusc",
                "mustard",
                "nut",
                "peanut",
                "pork",
                "sesame",
                "shellfish",
                "soy",
                "sulphite"
              ]
            }
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "boolean"
      },
      "answer_domain": {
        "kind": "enumerated",
        "values": [
          false,
          true
        ],
        "cardinality": 2
      },
      "capacity": {
        "calculation": "ceil(1000 * log2(2))",
        "unit": "millibits",
        "millibits": 1000,
        "bounded": true
      },
      "sensitivity": {
        "class": "high",
        "rationale": "Dietary exclusions are a documented proxy for religious observance and for medical conditions, both special categories under GDPR Article 9. The answer is one bit; the inference it supports is not proportionate to that. Deployments should require explicit approval rather than a standing rule for a new relationship, and should not treat low capacity as low sensitivity.",
        "proxy_for": [
          "religion",
          "health"
        ]
      },
      "freshness": {
        "default_maximum_source_age": "P30D"
      },
      "assurance_profiles": [
        "authenticated-answer"
      ],
      "implementation_digest": null,
      "provenance": {
        "author": "Q2D Protocol Project",
        "reviewed_by": [],
        "effective_from": "2026-08-03",
        "revoked_from": null
      },
      "test_vectors": [
        {
          "name": "compatible-single-safe-item",
          "public_context": {
            "menu": [
              {
                "item_id": "risotto",
                "contains": [
                  "milk"
                ]
              },
              {
                "item_id": "salad",
                "contains": []
              }
            ]
          },
          "private_input": {
            "excludes": [
              "milk",
              "gluten"
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": true,
            "capacity_debit_millibits": 1000
          }
        },
        {
          "name": "incompatible-every-item-conflicts",
          "public_context": {
            "menu": [
              {
                "item_id": "pasta",
                "contains": [
                  "gluten",
                  "egg"
                ]
              },
              {
                "item_id": "chowder",
                "contains": [
                  "milk",
                  "fish"
                ]
              }
            ]
          },
          "private_input": {
            "excludes": [
              "gluten",
              "milk"
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": false,
            "capacity_debit_millibits": 1000
          }
        },
        {
          "name": "no-constraints-is-always-compatible",
          "public_context": {
            "menu": [
              {
                "item_id": "steak",
                "contains": [
                  "meat"
                ]
              }
            ]
          },
          "private_input": {
            "excludes": []
          },
          "expect": {
            "outcome": "answer",
            "result": true,
            "capacity_debit_millibits": 1000
          }
        },
        {
          "name": "reject-empty-menu",
          "public_context": {
            "menu": []
          },
          "private_input": {
            "excludes": [
              "nut"
            ]
          },
          "expect": {
            "outcome": "reject",
            "before_private_access": true,
            "internal_reason": "public_context_schema_violation",
            "wire": {
              "status": "deny",
              "external_reason": "unavailable"
            }
          }
        },
        {
          "name": "reject-unknown-allergen-token",
          "public_context": {
            "menu": [
              {
                "item_id": "x",
                "contains": [
                  "kryptonite"
                ]
              }
            ]
          },
          "private_input": {
            "excludes": [
              "nut"
            ]
          },
          "expect": {
            "outcome": "reject",
            "before_private_access": true,
            "internal_reason": "public_context_schema_violation",
            "wire": {
              "status": "deny",
              "external_reason": "unavailable"
            }
          }
        }
      ],
      "entry_digest": "sha256:bd08ff230de0d8ce34de99967f7a9097988b49058f0a21dd35b9444c24098e35"
    },
    {
      "id": "https://q2d.dev/predicates/scheduling/availability-window",
      "version": "0.1",
      "status": "active",
      "title": "Availability window",
      "question": "Which is the first of these candidate slots the subject is free for, if any?",
      "question_notes": [
        "The requester proposes the candidates, so the answer domain is bounded by the request and the capacity debit scales with it. Returning every free slot would leak the shape of a calendar; returning the first bounds disclosure to one choice.",
        "A granularity floor prevents minute-level probing from reconstructing a schedule through repeated narrow candidates."
      ],
      "release_shape": "interval",
      "public_context_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidates"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "private_input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "busy"
        ],
        "properties": {
          "busy": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 7
      },
      "answer_domain": {
        "kind": "computed",
        "expression": "{0 .. len(public_context.candidates) - 1} union {null}",
        "cardinality_expression": "len(public_context.candidates) + 1",
        "maximum_cardinality": 9
      },
      "capacity": {
        "calculation": "table lookup on len(public_context.candidates) + 1",
        "unit": "millibits",
        "table": {
          "2": 1000,
          "3": 1585,
          "4": 2000,
          "5": 2322,
          "6": 2585,
          "7": 2808,
          "8": 3000,
          "9": 3170
        },
        "maximum_millibits": 3170,
        "bounded": true,
        "notes": "Not constant. The responder looks the effective cardinality up in this table; it never computes log2 and never accepts a debit asserted by the requester."
      },
      "constraints": {
        "minimum_slot_duration": "PT30M",
        "maximum_horizon": "P14D",
        "notes": "A candidate shorter than the floor, or further out than the horizon, is rejected before private access. Both are anti-probing controls, not usability limits."
      },
      "sensitivity": {
        "class": "moderate",
        "rationale": "Availability patterns proxy for religious observance, caregiving, medical appointments, and employment. A recurring unavailability that survives many queries is more revealing than any single answer, which is what the disclosure-capacity budget is for.",
        "proxy_for": [
          "religion",
          "health",
          "family-status"
        ]
      },
      "freshness": {
        "default_maximum_source_age": "PT1H"
      },
      "assurance_profiles": [
        "authenticated-answer"
      ],
      "implementation_digest": null,
      "provenance": {
        "author": "Q2D Protocol Project",
        "reviewed_by": [],
        "effective_from": "2026-08-03",
        "revoked_from": null
      },
      "test_vectors": [
        {
          "name": "first-candidate-free",
          "public_context": {
            "candidates": [
              {
                "start": "2026-08-10T18:00:00Z",
                "end": "2026-08-10T20:00:00Z"
              },
              {
                "start": "2026-08-11T18:00:00Z",
                "end": "2026-08-11T20:00:00Z"
              }
            ]
