            "capacity_debit_millibits": 1585
          }
        },
        {
          "name": "none-free-returns-null",
          "public_context": {
            "candidates": [
              {
                "start": "2026-08-10T18:00:00Z",
                "end": "2026-08-10T20:00:00Z"
              }
            ]
          },
          "private_input": {
            "busy": [
              {
                "start": "2026-08-10T17:00:00Z",
                "end": "2026-08-10T23:00:00Z"
              }
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": null,
            "capacity_debit_millibits": 1000
          }
        },
        {
          "name": "reject-slot-below-granularity-floor",
          "public_context": {
            "candidates": [
              {
                "start": "2026-08-10T18:00:00Z",
                "end": "2026-08-10T18:05:00Z"
              }
            ]
          },
          "private_input": {
            "busy": []
          },
          "expect": {
            "outcome": "reject",
            "before_private_access": true,
            "internal_reason": "constraint_violation_minimum_slot_duration",
