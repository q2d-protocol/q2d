    {
      "id": "https://q2d.dev/predicates/contact/contactable-for",
      "version": "0.1",
      "status": "active",
      "title": "Contactability for a stated purpose",
      "question": "For this declared purpose, what class of contact does the subject's policy permit?",
      "question_notes": [
        "Returns a permission class, never a contact detail. A requester learns whether it may call; it does not learn a number.",
        "The purpose code is a signed field of the request, so the answer is bound to the purpose it was asked for. Asking again with a different purpose is a distinct request and a distinct policy decision."
      ],
      "release_shape": "enum",
      "public_context_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose_code"
        ],
        "properties": {
          "purpose_code": {
            "type": "string",
            "enum": [
              "social.event-planning",
              "social.introduction",
              "commercial.enquiry",
              "logistics.delivery",
              "urgent.safety"
            ]
          }
        }
      },
      "private_input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "purpose_code",
                "permits"
              ],
              "properties": {
                "purpose_code": {
                  "type": "string"
                },
                "permits": {
                  "type": "string",
                  "enum": [
                    "none",
                    "async",
                    "synchronous"
                  ]
                }
              }
            }
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": [
          "none",
          "async",
          "synchronous"
        ]
      },
      "answer_domain": {
        "kind": "enumerated",
        "values": [
          "none",
          "async",
          "synchronous"
        ],
        "cardinality": 3
      },
      "capacity": {
        "calculation": "ceil(1000 * log2(3))",
        "unit": "millibits",
        "millibits": 1585,
        "bounded": true,
        "notes": "Deliberately non-integral. An implementation that rounds, truncates, or stores this as an integer will disagree with a conforming one on every budget total. See registry/README.md on capacity arithmetic."
      },
      "default_when_no_rule_matches": "none",
      "sensitivity": {
        "class": "moderate",
        "rationale": "The answer itself is a preference. What it reveals is the existence and shape of a relationship: a 'synchronous' answer to an unfamiliar requester says more about standing than about contact preference. Denial normalization matters more here than the capacity debit.",
        "proxy_for": [
          "relationship-existence"
        ]
      },
      "freshness": {
        "default_maximum_source_age": "P7D"
      },
      "assurance_profiles": [
        "authenticated-answer"
      ],
      "implementation_digest": null,
      "provenance": {
        "author": "Q2D Protocol Project",
        "reviewed_by": [],
        "effective_from": "2026-08-03",
        "revoked_from": null
      },
      "test_vectors": [
        {
          "name": "matching-rule-permits-async",
          "public_context": {
            "purpose_code": "social.event-planning"
          },
          "private_input": {
            "rules": [
              {
                "purpose_code": "social.event-planning",
                "permits": "async"
              },
              {
                "purpose_code": "commercial.enquiry",
                "permits": "none"
              }
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": "async",
            "capacity_debit_millibits": 1585
          }
        },
        {
          "name": "matching-rule-denies",
          "public_context": {
            "purpose_code": "commercial.enquiry"
          },
          "private_input": {
            "rules": [
              {
                "purpose_code": "commercial.enquiry",
                "permits": "none"
              }
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": "none",
            "capacity_debit_millibits": 1585
          }
        },
        {
          "name": "no-matching-rule-falls-closed",
          "public_context": {
            "purpose_code": "urgent.safety"
          },
          "private_input": {
            "rules": [
              {
                "purpose_code": "social.introduction",
                "permits": "synchronous"
              }
            ]
          },
          "expect": {
            "outcome": "answer",
            "result": "none",
            "capacity_debit_millibits": 1585
          }
        },
        {
          "name": "reject-unregistered-purpose-code",
          "public_context": {
            "purpose_code": "marketing.bulk"
          },
          "private_input": {
            "rules": []
          },
          "expect": {
            "outcome": "reject",
            "before_private_access": true,
            "internal_reason": "public_context_schema_violation",
            "wire": {
              "status": "deny",
              "external_reason": "unavailable"
            }
          }
        }
      ],
      "entry_digest": "sha256:ec62e8d808297121a316a0bbb5c04c13fd3dc3e69751edfa08d21d7ff4e8ca87"
    }
  ],
  "capacity_unit": {
    "name": "millibits",
    "definition": "One thousandth of one bit of answer-alphabet capacity.",
    "derivation": "ceil(1000 * log2(cardinality)), computed once when a registry entry is authored.",
    "rules": [
      "A responder MUST take the capacity value from the registry entry. It MUST NOT compute log2 at runtime.",
      "Budgets are accumulated by integer addition, so accumulation is exact and order-independent.",
      "Rounding is ceiling, so the accounting can over-charge but never under-charge.",
      "The unit is part of the registry contract. Changing it invalidates every stored budget."
    ]
  },
  "denial_normalization": {
    "external_reason": "unavailable",
    "posture": "Every rejection in this manifest returns an identical external response regardless of cause. The internal reason is recorded in the local audit event and never reaches the wire.",
    "rationale": "A precise external error tells a requester which check failed. Even a schema violation confirms the predicate is supported by this custodian, which is custodian-private policy. The safe default is one external class for every rejection; a deployment may report precisely only where its sensitivity class explicitly permits it."
  },
  "entry_digest_rule": {
    "algorithm": "sha256",
    "over": "the entry object with entry_digest removed, serialized under spec/serialization.md \u00a71. Stated by citation rather than restated: this field used to carry an abbreviated copy that said 'object keys sorted ascending' without saying by what, which is the one detail two implementations can disagree about.",
    "purpose": "A requester states the digest of the entry it built against. A mismatch means this predicate's definition differs between the two parties, which is a semantic disagreement and rejects.",
    "note": "The manifest digest a custodian pins and the entry digest a requester declares are different things. The manifest digest is what this custodian accepted; the entry digest is what the two parties agree the predicate means."
  }
}
