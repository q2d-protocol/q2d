#!/usr/bin/env python3
"""Rejects the vector the correct runner answers.

The clearest divergence there is, and one whose wire response is an object —
so it must be reported before anything asks whether the bytes are comparable.
"""
import json, sys

vector = json.loads(open(sys.argv[1]).read())
if vector["id"] != "message/sign/query-minimal":
    print(f"no canned answer for {vector['id']}", file=sys.stderr)
    raise SystemExit(1)
json.dump({"vector_id": vector["id"], "outcome": "rejected",
           "rejection": {"internal_reason": "unknown_key",
                         "wire": {"status": "deny", "external_reason": "unavailable"}},
           "implementation": {"name": "q2d-rejecting", "version": "0.0.0"}},
          sys.stdout)
