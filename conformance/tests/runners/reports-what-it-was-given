#!/usr/bin/env python3
"""Echoes the field names it received, so a test can prove `expect` never arrives."""
import json, sys
vector = json.loads(open(sys.argv[1]).read())
json.dump({"vector_id": vector["id"], "outcome": "error",
           "detail": "fields: " + ",".join(sorted(vector)),
           "implementation": {"name": "q2d-echo", "version": "0.0.0"}}, sys.stdout)
