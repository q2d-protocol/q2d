#!/usr/bin/env python3
"""Answers a registry rejection with core-model.md §5.2's whole response.

What a conforming implementation returns. The registry vectors assert two of
those four fields, because predicate evaluation is what they test — so this
runner must pass them, not fail for returning too much.
"""
import json, sys

RECEIPT = {"request_digest": "sha-256:" + "0" * 64,
           "decision_class": "unavailable",
           "decided_at": "2026-01-01T00:00:00Z",
           "responder": "did:example:test-custodian-1",
           "signature_suite": "eddsa-jws-2026"}

vector = json.loads(open(sys.argv[1]).read())
if vector["id"] != "denial/uniformity-c/budget-exhausted":
    print(f"no canned answer for {vector['id']}", file=sys.stderr)
    raise SystemExit(1)
json.dump({"vector_id": vector["id"], "outcome": "rejected",
           "rejection": {"internal_reason": "budget_exhausted",
                         "wire": {"status": "deny",
                                  "external_reason": "unavailable",
                                  "receipt": RECEIPT,
                                  "signature": "z" * 86},
                         "step": 15},
           "implementation": {"name": "q2d-whole", "version": "0.0.0"}},
          sys.stdout)
