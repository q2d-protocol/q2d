#!/usr/bin/env python3
"""Reports the signed envelope as a structure instead of its serialization.

Not a format limitation — a disagreement with any runner that serializes, and
one where this side never produced the artefact the comparison is over.
"""
import json, sys

vector = json.loads(open(sys.argv[1]).read())
if vector["id"] != "message/sign/query-minimal":
    print(f"no canned answer for {vector['id']}", file=sys.stderr)
    raise SystemExit(1)
json.dump({"vector_id": vector["id"], "outcome": "ok",
           "output": {"protected": {}, "payload": {}, "signature": ""},
           "implementation": {"name": "q2d-unserialized", "version": "0.0.0"}},
          sys.stdout)
