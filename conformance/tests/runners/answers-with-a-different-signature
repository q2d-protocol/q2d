#!/usr/bin/env python3
"""One byte different in a value the specification requires determinism over."""
import json, sys
vector = json.loads(open(sys.argv[1]).read())
if vector["id"] != "message/sign/query-minimal":
    print("only answers the signing vector", file=sys.stderr)
    raise SystemExit(1)
json.dump({"vector_id": vector["id"], "outcome": "ok",
           "output": {"signed": "x", "routing": {}},
           "implementation": {"name": "q2d-divergent", "version": "0.0.0"}}, sys.stdout)
