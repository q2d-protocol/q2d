    "envelope": {
      "signed": "eyJrZXlfaWQiOiJ0ZXN0LXJlcXVlc3Rlci0xIiwic3VpdGUiOiJlZGRzYS1qd3MtMjAyNiJ9..MDKaddvUkJU2fLjpRukjwobbaXTDCVxAOBSMtLxlr4VmA_fXjcBiLivEpZuTyXi5FaxXb8gue2PZ_qIix4DBAQ",
      "routing": {
        "q2d_version": "0.1",
        "type": "query",
        "target": {
          "custodian": "https://friend.example/.well-known/q2d"
        },
        "predicate": {
          "id": "https://q2d.dev/predicates/dietary/menu-compatible",
          "version": "0.1"
        },
        "expires_at": "2026-07-31T09:05:00Z"
      }
    }
  },
  "expect": {
